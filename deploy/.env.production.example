# Template for /opt/pos-fiplex/.env on the server. Copy it, fill in the
# secrets, and keep the real file off git (chmod 600, root-owned).
#
# Generate each secret with:  openssl rand -hex 32

# ---- Image -------------------------------------------------------------
# CI overwrites this with the GHCR tag it just pushed. Use pos-fiplex:local
# only for a hand-built image on the server.
APP_IMAGE=ghcr.io/fideliskagashe26/fiplexpos:latest

# ---- Host bindings (127.0.0.1 only; nginx fronts these) -----------------
# 8080 is taken by nginx and 8092 by offlinepharmacy on this host.
APP_BIND=8093
MINIO_BIND=9000
MINIO_CONSOLE_BIND=9001

# ---- App ---------------------------------------------------------------
APP_ENV=production
APP_NAME=POS-Fiplex
# Empty = host-only cookies, which is what we want on a single subdomain.
COOKIE_DOMAIN=
WEB_FRONTEND_CROSS_ORIGIN=false
# Empty: the SPA is served from the same origin as the API, so no CORS needed.
CORS_ALLOW_ORIGINS=

# ---- Database ----------------------------------------------------------
# DB_HOST/DB_PORT are pinned in docker-compose.prod.yml; do not set them here.
DB_USER=pos_user
DB_PASSWORD=CHANGE_ME
DB_NAME=pos_fiplex
DB_SSLMODE=disable
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=2
DB_MAX_LIFETIME_MINUTES=10

# ---- Migrations --------------------------------------------------------
# Migrations are compiled into the binary (sqlc/migrations/embed.go), so this
# runs from the embedded FS — no files needed in the image.
AUTO_MIGRATE=true

# Destructive. Must stay false in production.
ENABLE_DB_WIPE=false

# ---- Logging -----------------------------------------------------------
LOG_LEVEL=info
LOG_JSON_FORMAT=true

# ---- JWT ---------------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_DURATION_HOURS=24
JWT_REFRESH_DURATION_DAYS=7
JWT_ISSUER=pos-fiplex

# ---- Object storage (MinIO, S3-compatible) -----------------------------
# R2_ENDPOINT and R2_USE_SSL are pinned in docker-compose.prod.yml.
# These double as the MinIO root credentials, so treat them as secrets.
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=pos-fiplex
# Browser-facing base URL. GetFileShareLink returns "<domain>/<object>", and
# nginx maps /storage/ onto the bucket. Without this the app would hand out
# presigned links pointing at http://minio:9000, which no browser can reach.
R2_PUBLIC_DOMAIN=https://shop.linkamall.com/storage
R2_EXPIRY_SECONDS=3600

# ---- Payments (optional) -----------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PROD=false
